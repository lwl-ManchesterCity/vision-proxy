# vision-proxy — Route B vision channel credentials
#
# Copy this file to `scripts/.env` (or `./.env` in the cwd that runs vision.js)
# and fill in your real values. The `scripts/.env` location is the default
# fallback; a project-level `./.env` in the cwd takes priority.
#
# Lookup order in scripts/vision.js:
#   1. process.env (shell / Claude Code env)
#   2. ./.env  (cwd of the caller — project override)
#   3. scripts/.env  (skill default)

# Required — your multimodal model API key.
# Tested with Alibaba DashScope (qwen-vl-max); works with any OpenAI-compatible
# /chat/completions endpoint via VISION_API_BASE.
VISION_API_KEY=sk-your-key-here

# Optional — defaults to DashScope.
# VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional — default model.
# VISION_MODEL=qwen-vl-max

# Optional — set to 1 to tell the skill the main model already has native
# vision and should bypass vision-proxy entirely (skips the hook, no
# transcription). Use only after manual canary verification (see SKILL.md §0).
# VISION_NATIVE_VISION=0
